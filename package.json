{
  "name": "flash-bot",
  "version": "1.0.0",
  "description": "FLASH BOT — بوت واتساب احترافي قابل للتوسيع",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "node --watch bin/cli.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "flash-bot"
  ],
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.2.3",
    "file-type": "^21.0.0",
    "jimp": "^1.6.1",
    "node-webpmux": "^3.2.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "pino-pretty": "^13.0.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "bin": {
    "flash-bot": "./bin/cli.js"
  },
  "files": [
    "index.js",
    "settings.js",
    "handler.js",
    "lib",
    "langs",
    "bin",
    "plugins",
    ".env.example",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./settings": "./settings.js",
    "./lib/*": "./lib/*",
    "./langs/*": "./langs/*"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "jimp": "^1.6.1",
    "zod": "^4.6.6"
  }
}